# Version 2: works with and without an initramfs, reuses Portage's MAKEOPTS
# and niceness, asks about new kernel options (make oldconfig), rebuilds
# external modules, stops on the first failed step, logs every step, and
# removes kernels completely (initramfs included).

set -o pipefail
shopt -s nullglob

readonly KERNIE_VERSION="2.0"
readonly CONF_FILE=${KERNIE_CONF:-/etc/kernie.conf}
readonly BACKTITLE="Kernie ${KERNIE_VERSION} - Gentoo kernel manager"
readonly LOCK_FILE=/run/kernie.lock

# ---------------------------------------------------------------------------
# Configuration (see /etc/kernie.conf for the meaning of each setting)
# ---------------------------------------------------------------------------

# shellcheck source=/dev/null
[[ -r $CONF_FILE ]] && source "$CONF_FILE"

# kernie 1 used GEN_INITRAMFS / GEN_INITRAMFS_CMD; map them if the new names are unset
if [[ -z ${INITRAMFS:-} ]]; then
    if [[ ${GEN_INITRAMFS:-0} -eq 1 ]]; then INITRAMFS=kernie; else INITRAMFS=auto; fi
fi
if [[ -z ${INITRAMFS_CMD:-} && -n ${GEN_INITRAMFS_CMD:-} ]]; then
    INITRAMFS_CMD=$GEN_INITRAMFS_CMD
fi

: "${KERNEL_SOURCES_PATH:=/usr/src/linux}"
: "${KERNEL_BACKUP_PATH:=/root/kernel.bak}"
: "${PROTECT_KERNEL:=1}"
: "${INITRAMFS_CMD:=dracut --force --kver %KVER%}"
: "${UPDATE_GRUB:=auto}"
: "${GRUB_CFG:=/boot/grub/grub.cfg}"
: "${CONFIG_TOOL:=menuconfig}"
: "${KEEP_KERNELS:=2}"
: "${LOG_FILE:=/var/log/kernie.log}"

if [[ -z ${KERNEL_MAKEOPTS:-} ]]; then
    KERNEL_MAKEOPTS=$(portageq envvar MAKEOPTS 2>/dev/null)
    [[ -n $KERNEL_MAKEOPTS ]] || KERNEL_MAKEOPTS="-j$(nproc)"
fi
if [[ -z ${KERNEL_NICENESS:-} ]]; then
    KERNEL_NICENESS=$(portageq envvar PORTAGE_NICENESS 2>/dev/null)
    [[ -n $KERNEL_NICENESS ]] || KERNEL_NICENESS=0
fi
read -ra MAKE_ARGS <<< "$KERNEL_MAKEOPTS"

USE_DIALOG=1
TMP_DIR=""

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Append a timestamped line to the log file.
log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG_FILE"
}

# Remove the temporary directory and clear the screen on exit.
cleanup() {
    [[ -n $TMP_DIR ]] && rm -rf "$TMP_DIR"
    (( USE_DIALOG )) && clear
}

# Print an error message and exit with status 1.
die() {
    (( USE_DIALOG )) && clear
    echo "kernie: $*" >&2
    exit 1
}

# Print the height and width for dialog output boxes: the terminal size minus a margin.
box_size() {
    local rows cols
    read -r rows cols < <(stty size 2>/dev/null || echo "24 80")
    echo "$(( rows - 4 )) $(( cols - 4 ))"
}

# Show a message, in a dialog box or as plain text.
ui_msg() {    # ui_msg <title> <text>
    log "MSG [$1] $2"
    if (( USE_DIALOG )); then
        dialog --backtitle "$BACKTITLE" --title "$1" --msgbox "$2" 0 0
    else
        printf '\n== %s ==\n%b\n' "$1" "$2"
    fi
}

# Ask a yes/no question and return 0 for yes.
ui_yesno() {    # ui_yesno <title> <question>
    if (( USE_DIALOG )); then
        dialog --backtitle "$BACKTITLE" --title "$1" --yesno "$2" 0 0
    else
        local answer
        printf '\n== %s ==\n%b\n' "$1" "$2" >&2
        read -rp "[y/N] " answer
        [[ $answer == [yY]* ]]
    fi
}

# Show a single-choice menu and print the chosen tag.
ui_menu() {    # ui_menu <title> <text> <tag> <item> ...
    local title=$1 text=$2
    shift 2
    if (( USE_DIALOG )); then
        dialog --backtitle "$BACKTITLE" --title "$title" --menu "$text" 0 0 0 "$@" 3>&1 1>&2 2>&3
        return
    fi
    local -a tags=()
    local i=1 n
    printf '\n== %s ==\n' "$title" >&2
    [[ -n $text ]] && printf '%b\n' "$text" >&2
    while (( $# >= 2 )); do
        tags+=("$1")
        printf '  %2d) %s  %s\n' "$i" "$1" "$2" >&2
        shift 2
        (( i++ ))
    done
    read -rp "Choice (empty to cancel): " n
    [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#tags[@]} )) || return 1
    printf '%s\n' "${tags[n-1]}"
}

# Show a multiple-choice list and print the chosen tags, one per line.
ui_checklist() {    # ui_checklist <title> <text> <tag> <item> ...
    local title=$1 text=$2
    shift 2
    if (( USE_DIALOG )); then
        local -a items=()
        while (( $# >= 2 )); do items+=("$1" "$2" off); shift 2; done
        dialog --backtitle "$BACKTITLE" --title "$title" --separate-output \
               --checklist "$text" 0 0 0 "${items[@]}" 3>&1 1>&2 2>&3
        return
    fi
    local -a tags=()
    local i=1 n
    printf '\n== %s ==\n' "$title" >&2
    [[ -n $text ]] && printf '%b\n' "$text" >&2
    while (( $# >= 2 )); do
        tags+=("$1")
        printf '  %2d) %s  %s\n' "$i" "$1" "$2" >&2
        shift 2
        (( i++ ))
    done
    read -rp "Numbers separated by spaces (empty to cancel): " -a picks
    (( ${#picks[@]} )) || return 1
    for n in "${picks[@]}"; do
        [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#tags[@]} )) && printf '%s\n' "${tags[n-1]}"
    done
}

# Run a non-interactive command, show its output live, log it and return the command's exit status.
run_step() {    # run_step <title> <command...>
    local title=$1 rc
    shift
    log "STEP [$title] $*"
    if (( USE_DIALOG )); then
        local size
        size=$(box_size)
        # shellcheck disable=SC2086
        "$@" 2>&1 | tee -a "$LOG_FILE" | dialog --backtitle "$BACKTITLE" --title "$title" --programbox $size
        rc=${PIPESTATUS[0]}
    else
        printf '\n== %s ==\n' "$title"
        "$@" 2>&1 | tee -a "$LOG_FILE"
        rc=${PIPESTATUS[0]}
    fi
    log "STEP [$title] exit status $rc"
    return "$rc"
}

# Run an interactive command, such as oldconfig or menuconfig, directly on the terminal.
run_interactive() {
    log "INTERACTIVE $*"
    (( USE_DIALOG )) && clear
    "$@"
    local rc=$?
    log "INTERACTIVE exit status $rc"
    return "$rc"
}

# Show the end of the log in a scrollable box, or in less (or tail) without dialog.
show_log() {
    local lines=2000 view
    [[ -s $LOG_FILE ]] || { ui_msg "Log" "The log ($LOG_FILE) is empty."; return 0; }
    view=$TMP_DIR/log
    tail -n "$lines" "$LOG_FILE" > "$view"
    if (( USE_DIALOG )); then
        local size
        size=$(box_size)
        # shellcheck disable=SC2086
        dialog --backtitle "$BACKTITLE" --title "Last $lines lines of $LOG_FILE (arrows, PgUp/PgDn, G = end)" \
               --exit-label Close --textbox "$view" $size
    elif command -v less >/dev/null; then
        less +G "$view"
    else
        tail -n 50 "$view"
    fi
}

# Report a failed step, offer to show the log and return 1.
fail() {    # fail <step>
    if ui_yesno "Failed" "$1 failed. Nothing after this step was run.\n\nFull output: $LOG_FILE\n\nShow the log now?"; then
        show_log
    fi
    return 1
}

# Print the real directory behind the kernel sources symlink.
src_dir() {
    readlink -f "$KERNEL_SOURCES_PATH"
}

# Print the kernel release of a configured source tree, e.g. 7.2.11-gentoo.
kernel_release() {    # kernel_release <source dir>
    make -s -C "$1" kernelrelease 2>/dev/null
}

# Check that a version string is safe to use in paths that get deleted.
valid_version() {    # valid_version <version>
    [[ $1 =~ ^[0-9][A-Za-z0-9._+-]*$ ]]
}

# Check whether sys-kernel/installkernel is installed with a given USE flag.
installkernel_has() {    # installkernel_has <flag>
    portageq has_version / "sys-kernel/installkernel[$1]" >/dev/null 2>&1
}

# Print who builds the initramfs: installkernel, kernie, or nobody (no).
initramfs_mode() {
    case $INITRAMFS in
        auto)
            if installkernel_has dracut || installkernel_has ugrd; then
                echo installkernel
            else
                echo no
            fi
            ;;
        installkernel|kernie|no) echo "$INITRAMFS" ;;
        *) die "INITRAMFS='$INITRAMFS' in $CONF_FILE: use auto, installkernel, kernie or no" ;;
    esac
}

# Check whether kernie has to run grub-mkconfig itself after installing.
grub_needed() {    # grub_needed <initramfs mode>
    [[ $1 == kernie ]] && return 0    # the initramfs appears after installkernel's own grub-mkconfig
    case $UPDATE_GRUB in
        yes) return 0 ;;
        no) return 1 ;;
        *) ! installkernel_has grub ;;
    esac
}

# Print the package atom with slot that owns a source tree, e.g. sys-kernel/gentoo-sources:7.2.11.
sources_atom() {    # sources_atom <source dir>
    local cpv slot
    cpv=$(portageq owners / "$1/Makefile" 2>/dev/null | awk 'NR == 1 { print $1 }')
    [[ -n $cpv ]] || return 1
    slot=$(portageq metadata / installed "$cpv" SLOT 2>/dev/null)
    [[ -n $slot ]] || return 1
    printf '%s:%s\n' "${cpv%%-[0-9]*}" "${slot%%/*}"
}

# Check that the configuration exists and suits the initramfs mode before building.
check_config() {    # check_config <source dir> <initramfs mode>
    local cfg=$1/.config
    [[ -f $cfg ]] || { ui_msg "No configuration" "$cfg does not exist."; return 1; }

    if [[ $2 != no ]]; then
        if ! grep -q '^CONFIG_BLK_DEV_INITRD=y' "$cfg"; then
            ui_yesno "Initramfs support missing" "An initramfs will be built, but CONFIG_BLK_DEV_INITRD is not set, so the kernel cannot use it. Build anyway?" || return 1
        fi
        if [[ $2 == installkernel ]] && ! installkernel_has dracut && ! installkernel_has ugrd; then
            ui_msg "installkernel" "INITRAMFS=installkernel, but sys-kernel/installkernel has neither the dracut nor the ugrd flag, so no initramfs will be built."
        fi
    fi
    return 0
}

# Copy a kernel configuration into the backup directory under a given name.
backup_config() {    # backup_config <file> <name>
    mkdir -p "$KERNEL_BACKUP_PATH" || return 1
    cp -- "$1" "$KERNEL_BACKUP_PATH/$2" && log "Config saved as $KERNEL_BACKUP_PATH/$2"
}

# Save the running kernel's configuration from /proc/config.gz into the backup directory.
backup_running_config() {
    mkdir -p "$KERNEL_BACKUP_PATH" || return 1
    if [[ -r /proc/config.gz ]]; then
        zcat /proc/config.gz > "$KERNEL_BACKUP_PATH/config-$(uname -r)" &&
            log "Running config saved as $KERNEL_BACKUP_PATH/config-$(uname -r)"
    fi
}

# Check that the kernel, initramfs and GRUB entry of an installed kernel exist, and report.
verify_install() {    # verify_install <kernel release> <initramfs mode>
    local kver=$1 mode=$2 report="" ok=1
    if [[ -e /boot/vmlinuz-$kver ]]; then
        report+="Kernel:    /boot/vmlinuz-$kver\n"
    else
        report+="Kernel:    MISSING /boot/vmlinuz-$kver\n"; ok=0
    fi
    if [[ $mode != no ]]; then
        if [[ -e /boot/initramfs-$kver.img ]]; then
            report+="Initramfs: /boot/initramfs-$kver.img\n"
        else
            report+="Initramfs: MISSING /boot/initramfs-$kver.img\n"; ok=0
        fi
    else
        report+="Initramfs: none (INITRAMFS=no)\n"
    fi
    if [[ -r $GRUB_CFG ]] && grep -q "vmlinuz-$kver" "$GRUB_CFG"; then
        report+="GRUB:      entry present in $GRUB_CFG\n"
        if [[ $mode != no ]] && ! grep -q "initramfs-$kver.img" "$GRUB_CFG"; then
            report+="           but without initramfs-$kver.img: run Update GRUB\n"; ok=0
        fi
    else
        report+="GRUB:      no entry for $kver in $GRUB_CFG: run Update GRUB\n"; ok=0
    fi
    if (( ok )); then
        ui_msg "Installed $kver" "${report}\nReboot and pick $kver; the previous kernel stays in the GRUB menu as a fallback."
    else
        ui_msg "Check $kver" "$report"
    fi
}

# ---------------------------------------------------------------------------
# Building
# ---------------------------------------------------------------------------

# Build and install the selected sources, its modules, external modules, initramfs and GRUB entry, stopping at the first failure.
build_and_install() {
    local src mode kver
    src=$(src_dir)
    mode=$(initramfs_mode)
    check_config "$src" "$mode" || return 1

    run_step "Building the kernel ($KERNEL_MAKEOPTS)" \
        nice -n "$KERNEL_NICENESS" make -C "$src" "${MAKE_ARGS[@]}" || { fail "The build"; return 1; }
    run_step "Installing modules" make -C "$src" modules_install || { fail "make modules_install"; return 1; }

    if ! run_step "Rebuilding external modules" emerge --ask=n --oneshot @module-rebuild; then
        ui_yesno "External modules" "emerge @module-rebuild failed (see $LOG_FILE). Out-of-tree modules such as nvidia-drivers will not load with the new kernel.\n\nInstall the kernel anyway?" || return 1
    fi

    kver=$(kernel_release "$src")
    [[ -n $kver ]] || { fail "Reading the kernel release"; return 1; }

    run_step "Installing kernel $kver" make -C "$src" install || { fail "make install"; return 1; }

    if [[ $mode == kernie ]]; then
        build_initramfs "$kver" || return 1
    fi
    if grub_needed "$mode"; then
        run_step "Updating GRUB" grub-mkconfig -o "$GRUB_CFG" || { fail "grub-mkconfig"; return 1; }
    fi

    backup_config "$src/.config" "config-$kver"
    verify_install "$kver" "$mode"
}

# Build the initramfs of a kernel release with INITRAMFS_CMD.
build_initramfs() {    # build_initramfs <kernel release>
    local cmd=${INITRAMFS_CMD//%KVER%/$1}
    local -a argv
    read -ra argv <<< "$cmd"
    run_step "Building initramfs for $1" "${argv[@]}" || { fail "Building the initramfs"; return 1; }
}

# Add the sources' slot to the world file so emerge --depclean keeps them.
protect_sources() {    # protect_sources <source dir>
    local atom
    (( PROTECT_KERNEL )) || return 0
    if atom=$(sources_atom "$1"); then
        run_step "Adding $atom to world" emerge --ask=n --noreplace "$atom" ||
            ui_msg "World file" "Could not add $atom to the world file; it may be removed by emerge --depclean."
    else
        ui_msg "World file" "Could not find the package that owns $1; it was not added to the world file."
    fi
}

# ---------------------------------------------------------------------------
# Menu actions
# ---------------------------------------------------------------------------

# Let the user point the kernel sources symlink at other sources; return 1 if cancelled.
select_kernel() {
    local -a items=()
    local num name mark choice
    while IFS=$'\t' read -r num name mark; do
        items+=("$num" "$name${mark:+  (current)}")
    done < <(eselect kernel list 2>/dev/null |
             awk '/^ *\[[0-9]+\]/ { n = $1; gsub(/[][]/, "", n); printf "%s\t%s\t%s\n", n, $2, ($3 == "*" ? "*" : "") }')
    (( ${#items[@]} )) || { ui_msg "No sources" "eselect kernel list shows no kernel sources."; return 1; }
    choice=$(ui_menu "Kernel sources" "Point $KERNEL_SOURCES_PATH at:" "${items[@]}") || return 1
    eselect kernel set "$choice" || { fail "eselect kernel set $choice"; return 1; }
    log "Selected sources $(src_dir)"
}

# Menu action: select other kernel sources.
do_select() {
    select_kernel && ui_msg "Kernel sources" "$KERNEL_SOURCES_PATH now points to $(src_dir)."
}

# Menu action: move to new sources, carry the configuration over, resolve new options, then build and install.
do_upgrade() {
    local old_src src choice newopts file
    local -a items=()

    old_src=$(src_dir)
    [[ -f $old_src/.config ]] && backup_config "$old_src/.config" "config-$(kernel_release "$old_src" || basename "$old_src")"
    backup_running_config

    select_kernel || return 0
    src=$(src_dir)

    # Starting configuration for the new tree
    [[ -r /proc/config.gz ]] && items+=(running "Running kernel $(uname -r) (/proc/config.gz)")
    [[ -f $old_src/.config && $old_src != "$src" ]] && items+=(previous "Previous tree $(basename "$old_src")")
    items+=(backup "Choose a saved config from $KERNEL_BACKUP_PATH")
    [[ -f $src/.config ]] && items+=(keep "Keep the .config already in $(basename "$src")")
    choice=$(ui_menu "Starting configuration" "Which configuration should $(basename "$src") start from?" "${items[@]}") || return 0

    case $choice in
        running)  zcat /proc/config.gz > "$src/.config" ;;
        previous) cp -- "$old_src/.config" "$src/.config" ;;
        backup)
            items=()
            while IFS= read -r file; do
                items+=("$(basename "$file")" "$(date -r "$file" '+%F %R')")
            done < <(ls -t "$KERNEL_BACKUP_PATH"/config-* 2>/dev/null)
            (( ${#items[@]} )) || { ui_msg "No backups" "No saved configs in $KERNEL_BACKUP_PATH."; return 0; }
            file=$(ui_menu "Saved configs" "Newest first:" "${items[@]}") || return 0
            cp -- "$KERNEL_BACKUP_PATH/$file" "$src/.config"
            ;;
        keep) ;;
    esac || { fail "Copying the configuration"; return 1; }

    # Options that are new in this version
    newopts=$(make -s -C "$src" listnewconfig 2>/dev/null | grep -c '^CONFIG_')
    choice=$(ui_menu "New options" "$(basename "$src") has $newopts option(s) that your configuration doesn't mention yet." \
        oldconfig "Ask about each new option (make oldconfig)" \
        olddefconfig "Use the defaults for all of them (make olddefconfig)") || return 0
    run_interactive make -C "$src" "$choice" || { fail "make $choice"; return 1; }

    if ui_yesno "Review" "Open $CONFIG_TOOL to review the configuration before building?"; then
        run_interactive make -C "$src" "$CONFIG_TOOL" || { fail "make $CONFIG_TOOL"; return 1; }
    fi

    protect_sources "$src"
    build_and_install
}

# Menu action: change the configuration with CONFIG_TOOL, then build and install.
do_rebuild() {
    local src
    src=$(src_dir)
    [[ -f $src/.config ]] && backup_config "$src/.config" "config-$(kernel_release "$src")-$(date +%Y%m%d%H%M)"
    run_interactive make -C "$src" "$CONFIG_TOOL" || { fail "make $CONFIG_TOOL"; return 1; }
    build_and_install
}

# Menu action: build and install with the current configuration.
do_build() {
    ui_yesno "Build" "Build and install $(basename "$(src_dir)") with its current configuration?" || return 0
    build_and_install
}

# Print the kernel releases found in /boot or /lib/modules, oldest first.
installed_versions() {
    local f v
    {
        for f in /boot/vmlinuz-*; do
            v=${f#/boot/vmlinuz-}; v=${v%.old}; echo "$v"
        done
        for f in /lib/modules/*/; do
            v=${f%/}; echo "${v##*/}"
        done
    } | sort -uV
}

# Menu action: rebuild the initramfs of an installed kernel and update GRUB.
do_initramfs() {
    local -a items=()
    local v kver mode
    mode=$(initramfs_mode)
    for v in $(installed_versions); do
        [[ -d /lib/modules/$v ]] || continue
        items+=("$v" "$([[ $v == "$(uname -r)" ]] && echo running)")
    done
    (( ${#items[@]} )) || { ui_msg "Initramfs" "No installed kernels found."; return 0; }
    kver=$(ui_menu "Rebuild initramfs" "INITRAMFS=$INITRAMFS (currently: $mode). Command: ${INITRAMFS_CMD}\n\nRebuild for which kernel?" "${items[@]}") || return 0
    build_initramfs "$kver" || return 1
    run_step "Updating GRUB" grub-mkconfig -o "$GRUB_CFG" || { fail "grub-mkconfig"; return 1; }
    verify_install "$kver" kernie
}

# Menu action: regenerate the GRUB configuration.
do_grub() {
    run_step "Updating GRUB" grub-mkconfig -o "$GRUB_CFG" || fail "grub-mkconfig"
}

# Menu action: run make clean in the sources, keeping .config.
do_clean() {
    local src
    src=$(src_dir)
    ui_yesno "Clean" "Run make clean in $src?\n\nThe .config is kept; the next build starts from scratch." || return 0
    run_step "make clean" make -C "$src" clean || fail "make clean"
}

# Print the /boot files of the previous (.old) build of a kernel release, as installkernel leaves them.
old_build_files() {    # old_build_files <release>
    local f
    for f in /boot/vmlinuz-"$1".old /boot/System.map-"$1".old /boot/config-"$1".old \
             /boot/initramfs-"$1".img.old /boot/initramfs-"$1".old.img; do
        [[ -e $f ]] && echo "$f"
    done
}

# Print a kernel image's build stamp (e.g. "#5 SMP PREEMPT_DYNAMIC Sat Oct 17 ..."), the format of uname -v.
build_stamp() {    # build_stamp <vmlinuz file>
    command -v file >/dev/null || return 1
    file -bL "$1" 2>/dev/null | sed -n 's/.*version [^ ]* ([^)]*) \(#[^,]*\).*/\1/p'
}

# Check whether the running kernel may have been booted from the .old build; unknown counts as yes.
running_from_old() {
    local current
    current=/boot/vmlinuz-$(uname -r)
    [[ -e $current.old ]] || return 1
    [[ -e $current && "$(build_stamp "$current")" == "$(uname -v)" ]] && return 1
    return 0
}

# Remove only the /boot files of a kernel's previous (.old) build; modules and sources stay, as the current build uses them.
remove_old_build() {    # remove_old_build <release>
    local v=$1 f
    valid_version "$v" || { log "Refusing to remove odd version '$v'"; return 1; }
    if [[ $v == "$(uname -r)" ]] && running_from_old; then
        log "Refusing to remove $v.old: the running kernel may have been booted from it"
        return 1
    fi
    while IFS= read -r f; do
        rm -fv -- "$f"
    done < <(old_build_files "$v")
    return 0
}

# Uninstall the sources package that owns a tree (dropping its world entry), then delete leftover build files.
remove_sources() {    # remove_sources <source dir>
    local dir=$1 atom
    [[ -d $dir && $dir == /usr/src/linux-* ]] || return 0
    if atom=$(sources_atom "$dir"); then
        emerge --ask=n --unmerge "$atom" || { echo "emerge --unmerge $atom failed; $dir was kept"; return 1; }
        if sources_atom "$dir" >/dev/null; then
            echo "$atom is still installed; $dir was kept"
            return 1
        fi
    fi
    [[ -d $dir ]] && rm -rf -- "$dir" && echo "removed $dir"
    return 0
}

# Print source trees in /usr/src that have no installed kernel and aren't the selected sources.
sources_only_dirs() {
    local d v selected
    selected=$(src_dir)
    for d in /usr/src/linux-*/; do
        d=${d%/}
        v=${d#/usr/src/linux-}
        [[ $d == "$selected" || -L $d ]] && continue
        [[ -d /lib/modules/$v || -e /boot/vmlinuz-$v || -e /boot/vmlinuz-$v.old ]] && continue
        echo "$v"
    done
}

# Remove one kernel's /boot files, initramfs, modules, sources and world entry.
remove_kernel() {    # remove_kernel <release>
    local v=$1 f
    valid_version "$v" || { log "Refusing to remove odd version '$v'"; return 1; }
    [[ $v == "$(uname -r)" ]] && { log "Refusing to remove the running kernel $v"; return 1; }

    for f in /boot/vmlinuz-"$v" /boot/System.map-"$v" /boot/config-"$v" /boot/initramfs-"$v".img; do
        rm -fv -- "$f" "$f.old"
    done
    rm -fv -- /boot/initramfs-"$v".img.old /boot/initramfs-"$v".old.img
    [[ -d /lib/modules/$v ]] && rm -rf -- "/lib/modules/$v" && echo "removed /lib/modules/$v"

    remove_sources "/usr/src/linux-$v"
}

# Menu action: remove the kernels or .old builds the user ticks, never the running one.
do_delete() {
    local -a items=() picked=()
    local v running
    running=$(uname -r)
    for v in $(installed_versions); do
        if [[ $v == "$running" ]]; then
            if [[ -n $(old_build_files "$v") ]] && ! running_from_old; then
                items+=("$v.old" "previous build of the running kernel: /boot files only")
            fi
            continue
        fi
        items+=("$v" "whole kernel: /boot, modules$([[ -d /usr/src/linux-$v ]] && echo ", sources")")
        [[ -n $(old_build_files "$v") ]] && items+=("$v.old" "previous build only: /boot files")
    done
    for v in $(sources_only_dirs); do
        valid_version "$v" || continue
        if sources_atom "/usr/src/linux-$v" >/dev/null; then
            items+=("$v.src" "sources only, never built or already removed: uninstall the package")
        else
            items+=("$v.src" "leftover build files in /usr/src (no package)")
        fi
    done
    (( ${#items[@]} )) || { ui_msg "Delete kernels" "Nothing to remove besides the running kernel ($running)."; return 0; }
    mapfile -t picked < <(ui_checklist "Delete kernels" "The running kernel ($running) and the selected sources are not listed. A .old entry removes only that previous build's files in /boot; a .src entry only a source tree. Remove:" "${items[@]}")
    (( ${#picked[@]} )) || return 0
    ui_yesno "Delete kernels" "Remove these?\n\n  ${picked[*]}\n\nWhole kernels lose their /boot files, initramfs, modules, sources and world entry; .old entries only their /boot files; .src entries only their source tree and package. An unmerged package that the world file still wants (the newest gentoo-sources) comes back with the next @world update." || return 0
    for v in "${picked[@]}"; do
        if [[ $v == *.old ]]; then
            run_step "Removing $v" remove_old_build "${v%.old}" || ui_msg "Delete kernels" "Could not remove $v; see $LOG_FILE."
        elif [[ $v == *.src ]]; then
            run_step "Removing sources $v" remove_sources "/usr/src/linux-${v%.src}" || ui_msg "Delete kernels" "Could not remove the sources of ${v%.src}; see $LOG_FILE."
        else
            run_step "Removing $v" remove_kernel "$v" || ui_msg "Delete kernels" "Could not remove $v completely; see $LOG_FILE."
        fi
    done
    run_step "Updating GRUB" grub-mkconfig -o "$GRUB_CFG" || fail "grub-mkconfig"
}

# Menu action: keep only the newest KEEP_KERNELS kernels with eclean-kernel.
do_autoclean() {
    command -v eclean-kernel >/dev/null || { ui_msg "eclean-kernel" "app-admin/eclean-kernel is not installed."; return 0; }
    run_step "Kernels eclean-kernel would remove (keeping $KEEP_KERNELS)" eclean-kernel -p -n "$KEEP_KERNELS"
    ui_yesno "Clean old kernels" "Remove them? World entries of their sources stay; use Delete kernels for a complete removal." || return 0
    run_step "eclean-kernel" eclean-kernel -n "$KEEP_KERNELS" || { fail "eclean-kernel"; return 1; }
    run_step "Updating GRUB" grub-mkconfig -o "$GRUB_CFG" || fail "grub-mkconfig"
}

# Menu action: show the running kernel, sources, initramfs and GRUB handling.
do_status() {
    local src mode report opt
    src=$(src_dir)
    mode=$(initramfs_mode)
    report="Running kernel:  $(uname -r)\n"
    report+="Sources:         $KERNEL_SOURCES_PATH -> $src"
    [[ -f $src/.config ]] && report+=" ($(kernel_release "$src"))"
    report+="\n\nInitramfs:       INITRAMFS=$INITRAMFS -> $mode\n"
    case $mode in
        installkernel) report+="                 built by installkernel during make install\n" ;;
        kernie)        report+="                 built by kernie: ${INITRAMFS_CMD}\n" ;;
        no)            report+="                 none; root must mount without one\n" ;;
    esac
    report+="installkernel:   "
    for opt in dracut ugrd grub; do
        installkernel_has "$opt" && report+="+$opt " || report+="-$opt "
    done
    report+="\nGRUB update:     UPDATE_GRUB=$UPDATE_GRUB -> "
    grub_needed "$mode" && report+="kernie runs grub-mkconfig\n" || report+="installkernel runs grub-mkconfig\n"
    report+="\nmake options:    $KERNEL_MAKEOPTS (nice $KERNEL_NICENESS)\n"
    report+="\nLog:             $LOG_FILE\nConfig backups:  $KERNEL_BACKUP_PATH"
    ui_msg "Status" "$report"
}

# Print the command-line help.
usage() {
    cat <<EOF
Kernie ${KERNIE_VERSION} - Gentoo kernel manager

Usage: kernie [-n|--no-dialog] [command]

Without a command, kernie shows its menu.

Commands:
  status     Show the running kernel, sources, initramfs and GRUB handling
  select     Point $KERNEL_SOURCES_PATH at other sources (eselect kernel)
  upgrade    Select new sources, carry the config over, answer new options, build, install
  rebuild    Change the configuration ($CONFIG_TOOL), then build and install
  build      Build and install with the current configuration
  initramfs  Rebuild the initramfs of an installed kernel
  grub       Run grub-mkconfig
  clean      make clean in the sources (keeps .config)
  delete     Remove kernels (/boot files, initramfs, modules, sources, world entry),
             .old builds, or source trees without an installed kernel
  autoclean  Keep the newest $KEEP_KERNELS kernels with eclean-kernel
  log        View the end of the log

Options:
  -n, --no-dialog   Plain text prompts instead of dialog
  -h, --help        This text

Configuration: $CONF_FILE (override with KERNIE_CONF=<file>)
EOF
}

# Run the action that matches a command name.
run_command() {
    case $1 in
        status)    do_status ;;
        select)    do_select ;;
        upgrade)   do_upgrade ;;
        rebuild)   do_rebuild ;;
        build)     do_build ;;
        initramfs) do_initramfs ;;
        grub)      do_grub ;;
        clean)     do_clean ;;
        delete)    do_delete ;;
        autoclean) do_autoclean ;;
        log)       show_log ;;
        *) usage >&2; return 2 ;;
    esac
}

# Show the main menu until the user exits.
main_menu() {
    local choice
    while true; do
        choice=$(ui_menu "Main menu" "Sources: $(basename "$(src_dir)")   Running: $(uname -r)   Initramfs: $(initramfs_mode)" \
            status    "Show kernel, initramfs and GRUB status" \
            select    "Select kernel sources" \
            upgrade   "Upgrade to new sources (config, build, install)" \
            rebuild   "Change configuration, then build and install" \
            build     "Build and install with the current configuration" \
            initramfs "Rebuild an initramfs" \
            grub      "Update GRUB" \
            clean     "Clean the build tree" \
            delete    "Delete kernels" \
            autoclean "Remove old kernels (keep $KEEP_KERNELS, eclean-kernel)" \
            log       "View the log" \
            exit      "Exit") || return 0
        [[ $choice == exit ]] && return 0
        run_command "$choice"
    done
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

command=""
while (( $# )); do
    case $1 in
        -n|--no-dialog) USE_DIALOG=0 ;;
        -h|--help) usage; exit 0 ;;
        -*) usage >&2; exit 2 ;;
        *) command=$1 ;;
    esac
    shift
done

(( EUID == 0 )) || die "must be run as root"
if (( USE_DIALOG )) && { ! command -v dialog >/dev/null || [[ ! -t 0 || ! -t 1 ]]; }; then
    USE_DIALOG=0
fi
for tool in eselect portageq make; do
    command -v "$tool" >/dev/null || die "$tool not found"
done

mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null
touch "$LOG_FILE" 2>/dev/null || LOG_FILE=/dev/null

exec 9> "$LOCK_FILE"
flock -n 9 || die "another kernie is already running"

TMP_DIR=$(mktemp -d /tmp/kernie.XXXXXX) || die "cannot create a temporary directory"
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

log "kernie $KERNIE_VERSION started (${command:-menu})"
if [[ -n $command ]]; then
    run_command "$command"
else
    main_menu
fi
